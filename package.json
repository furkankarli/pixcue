{
  "name": "pixcue",
  "version": "0.0.0",
  "private": true,
  "description": "Free, open-source, browser-based motion graphics for video creators.",
  "license": "MIT",
  "author": "Furkan Karlı and Pixcue contributors",
  "homepage": "https://github.com/furkankarli/pixcue#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/furkankarli/pixcue.git"
  },
  "bugs": "https://github.com/furkankarli/pixcue/issues",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "lefthook install",
    "dev": "pnpm --filter studio dev",
    "build": "pnpm --filter studio build",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "tsc -p tsconfig.json && pnpm -r --parallel typecheck",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:visual": "vitest run --project visual",
    "test:visual:update": "vitest run --project visual --update",
    "test:formats": "vitest run --project formats",
    "changeset": "changeset",
    "new-template": "node scripts/new-template.ts",
    "brand": "node scripts/brand-assets.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/types": "^21.2.3",
    "@napi-rs/canvas": "1.1.0",
    "@types/node": "^24",
    "lefthook": "^2.2.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  }
}
