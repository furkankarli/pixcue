// Cloudflare Workers static assets: no Worker script, only the built studio.
// Deployed by Cloudflare Workers Builds (Git integration); see README.md.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "pixcue",
  "compatibility_date": "2026-11-01",
  "assets": {
    // Relative to this file.
    "directory": "./dist",
    // Any unknown path serves index.html; the editor keeps its state in the URL.
    "not_found_handling": "single-page-application"
  },
  "workers_dev": true,
  // Lets non-production branch builds get their own preview URL.
  "preview_urls": true
}
